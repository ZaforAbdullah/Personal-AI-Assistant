# ---- LLM provider: "gemini" (live) or "lmstudio" (local) ----
LLM_PROVIDER=lmstudio

# Gemini (used when LLM_PROVIDER=gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# LM Studio (used when LLM_PROVIDER=lmstudio). Start the local server in LM Studio first.
# From inside Docker the host machine is reachable as host.docker.internal.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Vector width stored in Postgres. nomic-embed-text = 768; gemini-embedding-001 is
# requested with dimensions=768 so both providers share one column width.
EMBEDDING_DIM=768

# ---- Database: "postgres" (local / docker) or "supabase" ----
DB_PROVIDER=postgres
DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5432/assistant
# Supabase: Project settings -> Database -> connection string (session pooler, port 5432).
# Enable the "vector" extension in the Supabase dashboard (Database -> Extensions) if the
# app cannot create it itself.
SUPABASE_DB_URL=postgresql+asyncpg://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Tools ----
# gif_search needs a free GIPHY key (https://developers.giphy.com). Leave empty to run
# without the GIF tool; calculator, knowledge_search and weather (Open-Meteo, no key) always work.
GIPHY_API_KEY=

# ---- Agent behaviour ----
# Sampling temperature and reply length cap, applied to both providers.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
MAX_TOOL_ROUNDS=4
TOOL_TIMEOUT_S=15
HISTORY_LIMIT=30

# ---- Frontend / ports ----
# Where the browser reaches the backend (baked into the frontend build).
NEXT_PUBLIC_API_URL=http://localhost:8000
# The frontend's port. Doubles as the CORS rule: the backend accepts browser calls from
# any hostname on this port and nothing else. Under docker compose it is also the
# published port of the frontend container.
#FRONTEND_PORT=3000
# A deployed frontend is not on that port. List its exact origin(s), comma separated.
#CORS_ORIGINS=https://my-frontend.up.railway.app
# Other docker compose published ports (change if something else already uses them)
#BACKEND_PORT=8000
#DB_PORT=5432
